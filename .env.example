MOVIE_APP_NAME=Movie Model API
MOVIE_DATABASE_URL=sqlite+aiosqlite:///./data/movie_model.sqlite3
MOVIE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://127.0.0.1:3100"]
MOVIE_TMDB_API_KEY=
MOVIE_TMDB_TIMEOUT=8
MOVIE_TMDB_CACHE_TTL=300
MOVIE_TMDB_CACHE_ENTRIES=128

# Optional: trained artifact directory, relative to the project root or absolute.
# MOVIE_RECOMMENDATION_MODEL_PATH=artifacts/recommendations/movielens-32m-top30-v1/model

# Per-source candidate budget, deadline (seconds), and maximum expanded artifact size.
MOVIE_RECOMMENDATION_CANDIDATE_LIMIT=40
MOVIE_RECOMMENDATION_SOURCE_TIMEOUT=10
MOVIE_RECOMMENDATION_ARTIFACT_MAX_MB=512
# Rank fusion weights; tune only after separate hybrid evaluation.
MOVIE_RECOMMENDATION_COLLABORATIVE_WEIGHT=1
MOVIE_RECOMMENDATION_CONTENT_WEIGHT=1

# Optional Compose settings (relative paths are resolved from compose.yaml).
# MOVIE_WEB_PORT=8080
# MOVIE_API_PORT=8081
# MOVIE_FRONTEND_PATH=../movie_model_frontend
# MOVIE_MODEL_HOST_PATH=./artifacts/recommendations/movielens-32m-top30-v1/model
